{
  "name": "ai-dev-doctor",
  "version": "0.1.0",
  "private": true,
  "description": "Local deterministic repository health checks for developer projects.",
  "type": "module",
  "bin": {
    "ai-dev-doctor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
